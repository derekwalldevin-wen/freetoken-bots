# Copy to .env locally — never commit real values.
OPENCODE_CLI=/path/to/opencode
OPENCODE_PORT=4096
OPENCODE_HOSTNAME=127.0.0.1
# Password file path (file mode 0600). Contents are the Basic-auth password.
OPENCODE_SERVER_PASSWORD_FILE=/path/to/opencode-server.password
# Optional: export password into the process instead of a file
# OPENCODE_SERVER_PASSWORD=replace-me
FREETOKEN_REPORT=/path/to/freetoken-bots/report.json
